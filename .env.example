# ─────────────────────────────────────────────────────────────────────────────
# Lunar Fusion — Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────

# =============================================================================
# FRONTEND CONFIGURATION (Configure in Vercel Dashboard)
# =============================================================================
# Set to your external backend host (e.g., https://lunar-fusion-api.onrender.com).
# If deploying both frontend and backend directly on Vercel, leave this empty ("")
# so requests automatically route to same-origin /api.
VITE_API_BASE_URL=http://localhost:8000

# =============================================================================
# BACKEND CONFIGURATION (Configure on Backend Host / Vercel Python Function)
# =============================================================================
# Secret key for JWT HS256 signing (Generate a random 32+ char string in production)
JWT_SECRET_KEY=lunar-fusion-jwt-secret-key-2026-sih-isro-demo

# Access token lifespan in minutes
JWT_ACCESS_EXPIRE_MINUTES=15

# Refresh token session lifespan in days
JWT_REFRESH_EXPIRE_DAYS=7

# Set to "true" in production to enforce Secure HTTPS cookies
COOKIE_SECURE=false

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:8443,http://localhost:5173,http://127.0.0.1:8443,https://your-project.vercel.app

# Database URL: sqlite:///./lunar_fusion.db (or external PostgreSQL / Turso)
DATABASE_URL=sqlite:///./lunar_fusion.db

# Optional Transactional Email (Resend API key)
EMAIL_API_KEY=
EMAIL_FROM=auth@lunarfusion.isro.gov.in
