# Database configuration (SQLite for dev, easily switchable to PostgreSQL)
DATABASE_URL=sqlite:///./lunar_fusion.db
LUNAR_CATALOG_DB=./lunar_catalog.db
LUNAR_MAX_UPLOAD_MB=100

# Authentication & JWT Secrets
# IMPORTANT: Generate a cryptographically secure random key in production!
JWT_SECRET_KEY=lunar-fusion-jwt-secret-key-2026-sih-isro-demo
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# Transactional Email (Resend ready)
EMAIL_API_KEY=
EMAIL_FROM=auth@lunarfusion.isro.gov.in
CONTACT_RECEIVER_EMAIL=admin@lunarfusion.isro.gov.in

# Strict CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:8443,http://localhost:5173,http://127.0.0.1:8443
COOKIE_SECURE=false
